# ─────────────────────────────────────────────────────────────────────────────
# IMN Group of Companies — environment template
# Copy to .env and fill in. NEVER commit .env.
#
# LOCAL DEMO MODE: while the three Supabase variables below are left empty the
# app runs on a local SQLite database (.data/imn.db) with uploads written to
# /public/uploads — identical schema, seed and code paths. Supplying the
# Supabase values switches the whole system to Supabase with zero code changes.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API). Leave empty for Local Demo Mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import in client components. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for canonical URLs, sitemap and OG tags.
# Optional until the domain is purchased — falls back to VERCEL_URL / request host.
NEXT_PUBLIC_SITE_URL=

# Optional hardening / sessions
ADMIN_SESSION_SECRET=
ADMIN_RATE_LIMIT_PER_MIN=10
CONTACT_RATE_LIMIT_PER_MIN=3
